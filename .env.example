# ============================================================
#  VARIABLES DE ENTORNO — EventoSuite
#  ⚠️  NUNCA subas este archivo a GitHub
# ============================================================

SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eventos_db

# Correo (Gmail: activa "Contraseñas de aplicación" en tu cuenta Google)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion
MAIL_DEFAULT_SENDER=tu_correo@gmail.com

# API REST — token para acceso externo (genera uno aleatorio)
API_TOKEN=genera_un_token_secreto_aqui

# Stripe — cobro de suscripciones (modo prueba hasta que pongas tus
# llaves reales, ver https://dashboard.stripe.com/test/apikeys)
# STRIPE_PRICE_ID_PRO debe ser un Price de Stripe configurado como
# recurring: interval=month, interval_count=6 (cada 6 meses, $250).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=